{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:writing": "node scripts/generate-writing.mjs",
    "sync:newsletter": "set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a; node scripts/update-newsletter-issues.mjs",
    "sync:seo": "node scripts/generate-seo-assets.js",
    "dev": "npm run sync:writing && npm run sync:newsletter && npm run sync:seo && vite",
    "build": "npm run sync:writing && npm run sync:newsletter && npm run sync:seo && vite build && node scripts/prerender-meta.js && node scripts/verify-crawler-html.js",
    "check:crawlers": "node scripts/check-live-crawlers.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "update:podcast": "node scripts/update-podcast-episodes.mjs",
    "build:astro": "npm run sync:writing && astro build",
    "dev:astro": "astro dev --host 0.0.0.0",
    "check:astro": "node scripts/check-astro-output.mjs",
    "prepare:images": "node scripts/prepare-home-images.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^6.1.0"
  }
}
