{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:writing": "astro sync",
    "sync:newsletter": "set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a; node scripts/update-newsletter-issues.mjs",
    "sync:seo": "npm run build",
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && npm run check:astro",
    "check:crawlers": "node scripts/check-live-crawlers.js",
    "preview": "astro preview --host 0.0.0.0",
    "lint": "eslint .",
    "update:podcast": "node scripts/update-podcast-episodes.mjs",
    "build:astro": "npm run build",
    "dev:astro": "npm run dev",
    "check:astro": "node scripts/check-astro-output.mjs",
    "prepare:images": "node scripts/prepare-home-images.mjs",
    "check:browser:astro": "node scripts/check-astro-browser.mjs",
    "check:routes": "node scripts/check-routes-browser.mjs",
    "check:publishing": "node scripts/check-publishing.mjs",
    "check:workshops": "node scripts/check-workshop-browser.mjs",
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "check:analytics": "node scripts/check-analytics-browser.mjs",
    "prepare:delivery": "node scripts/prepare-delivery-assets.mjs",
    "check:analytics:bridge": "node scripts/check-analytics-bridge.mjs",
    "check:navigation": "node scripts/check-navigation-browser.mjs",
    "check:bfcache": "node scripts/check-bfcache.mjs",
    "check:static-backgrounds": "node scripts/check-static-backgrounds.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "nostr-tools": "2.26.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
