---
import '../globals.css';
import { canonicalPath } from '../lib/structured-data';
interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  type?: string;
  publishedTime?: string;
  schema?: unknown;
}
const { title, description, path = Astro.url.pathname, image = Astro.props.ogImage || '/og-default.png', type = Astro.props.ogType || 'website', publishedTime, schema } = Astro.props;
const canonicalUrl = new URL(path, Astro.site);
canonicalUrl.pathname = canonicalPath(canonicalUrl.pathname);
const canonical = canonicalUrl.href;
const imageUrl = new URL(image, Astro.site).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Alfabet-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    {['/', '/home-duplicate', '/home-duplicate/'].includes(Astro.url.pathname) && <link rel="preload" href="/fonts/google/cormorantgaramond-latin.woff2" as="font" type="font/woff2" crossorigin />}
    <title>{title.includes('Other Stuff') ? title : `${title} | Other Stuff`}</title>
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Other Stuff" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {schemas.map(value => <script type="application/ld+json" set:html={JSON.stringify(value).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <noscript><style>.os-theme [style*="opacity:0"], .os-theme [style*="opacity: 0"] { opacity: 1 !important; transform: none !important; }</style></noscript>
    <slot />
    <script>
      // Keep analytics off preview hosts and out of the initial rendering work.
      const loadAnalytics = () => {
        if (location.hostname !== 'otherstuff.ai' || navigator.doNotTrack === '1') return;
        const tracker = document.createElement('script');
        tracker.src = 'https://unpkg.com/nanalytics-tracker@0.1.2/dist/index.global.js';
        tracker.async = true;
        tracker.dataset.siteUuid = 'c0cb28c5-6b00-4b5d-891a-ea3f8ebb47f8';
        tracker.dataset.cvmPubkey = 'd8a066f85d621d634e24ee0bf741e27b6436af28782195de8aa90972e310e937';
        // The former cvm.otherstuff.ai relay times out. Keep the verified relay.
        tracker.dataset.relays = 'wss://relay.contextvm.org';
        document.body.append(tracker);
      };
      const scheduleAnalytics = () => {
        if ('requestIdleCallback' in window) window.requestIdleCallback(loadAnalytics, { timeout: 3000 });
        else setTimeout(loadAnalytics, 0);
      };
      if (document.readyState === 'complete') scheduleAnalytics();
      else window.addEventListener('load', scheduleAnalytics, { once: true });
    </script>

  </body>
</html>
<style is:global>
  .os-theme .fade-in { opacity: 1; transform: none; }
</style>
