---
import { deliveryStatic } from '../lib/delivery-assets';
import '../globals.css';
import gradientDesktop from '../assets/gradient-desktop.webp';
import gradientMobile from '../assets/gradient-mobile.webp';
import fontFaces from '../delivery-fonts.css?raw';
import { deliveryFont } from '../lib/delivery-assets';
import { canonicalPath } from '../lib/structured-data';
interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  type?: string;
  publishedTime?: string;
  schema?: unknown;
}
const { title, description, path = Astro.url.pathname, image = Astro.props.ogImage || '/og-default.png', type = Astro.props.ogType || 'website', publishedTime, schema } = Astro.props;
const canonicalUrl = new URL(path, Astro.site);
canonicalUrl.pathname = canonicalPath(canonicalUrl.pathname);
const canonical = canonicalUrl.href;
const imageUrl = new URL(image, Astro.site).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" sizes="48x48" href={deliveryStatic('/favicon-48x48.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={deliveryStatic('/apple-touch-icon.png')} />
    <style is:inline set:html={fontFaces} />
    <link rel="preload" href={deliveryFont('/fonts/Alfabet-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={deliveryFont('/fonts/google/geist-latin.woff2')} as="font" type="font/woff2" crossorigin />
    {['/', '/home-duplicate', '/home-duplicate/', '/ai-automation', '/ai-automation/'].includes(Astro.url.pathname) && <link rel="preload" href={deliveryFont('/fonts/google/cormorantgaramond-latin.woff2')} as="font" type="font/woff2" crossorigin />}
    {['/', '/ai-automation', '/ai-automation/'].includes(Astro.url.pathname) && <>
      <link rel="preload" as="image" href={gradientMobile.src} media="(max-width: 768px)" fetchpriority="high" />
      <link rel="preload" as="image" href={gradientDesktop.src} media="(min-width: 769px)" fetchpriority="high" />
    </>}
    <title>{title.includes('Other Stuff') ? title : `${title} | Other Stuff`}</title>
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Other Stuff" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {schemas.map(value => <script type="application/ld+json" set:html={JSON.stringify(value).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <noscript><style>.os-theme [style*="opacity:0"], .os-theme [style*="opacity: 0"] { opacity: 1 !important; transform: none !important; }</style></noscript>
    <slot />
    <script>import '../client/analytics';</script>

  </body>
</html>
<style is:global>
  .os-theme .fade-in { opacity: 1; transform: none; }
</style>
