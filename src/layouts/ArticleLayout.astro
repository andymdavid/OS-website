---
import SiteLayout from './SiteLayout.astro';
import '../routes/WritingPost.css';
import { NavigationDraft } from '../components/NavigationDraft';
import { Footer } from '../components/Footer';
interface Props { title: string; description: string; canonical: string; image: string; schema: Record<string, unknown>; }
const { title, description, canonical, image, schema } = Astro.props;
---
<SiteLayout title={title} description={description} path={canonical} image={image} type="article" publishedTime={String(schema.datePublished)} schema={schema}>
  <div class="os-theme os-draft min-h-screen writing-post-page">
    <NavigationDraft client:load />
    <main><slot /></main>
    <Footer client:visible />
  </div>
</SiteLayout>
