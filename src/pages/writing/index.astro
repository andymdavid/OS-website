---
import SiteLayout from '@/layouts/SiteLayout.astro';
import NavigationDraft from '@/components/astro/Navigation.astro';
import CTASection from "@/components/astro/CTA.astro";
import Footer from '@/components/astro/Footer.astro';
import { getCollection } from 'astro:content';
const writingPosts = (await getCollection('writing')).map(entry => entry.data).sort((a,b) => b.date.localeCompare(a.date));
import "@/components/Hero.css";
import "@/routes/Writing.css";
import ArticleCard from '@/components/astro/ArticleCard.astro';

---
<SiteLayout title="Writing on AI Systems, Operations, and the Value Trap"
        description="Essays and field notes from Other Stuff on custom AI systems, AI workflow automation, operations, and the economic implications of AI."
        path="/writing" schema={[
 { '@context': 'https://schema.org', '@type': 'CollectionPage', url: 'https://otherstuff.ai/writing/', name: 'Writing on AI Systems, Operations, and the Value Trap' },
 { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: writingPosts.map((post,index) => ({'@type': 'ListItem',position:index+1,url:'https://otherstuff.ai/writing/'+post.slug+'/',name:post.title})) }
]}>
<div class="os-theme os-draft min-h-screen writing-page writing-index-page">
      
      <NavigationDraft titleOverride="OTHER STUFF" />
      <main>
        <section class="section writing-hero">
          <div class="section-container-wide writing-hero-inner">
            <div class="hero-title-block">
              <h1>Writing</h1>
              <p class="hero-bridge">
                Notes, ideas, and fieldwork from building with AI.
              </p>
            </div>
          </div>
        </section>

        {writingPosts.length > 0 ? (
          <section class="section writing-posts">
            <div class="writing-collection">
            <div class="writing-collection-header"><div>Latest writing <span>/ {writingPosts.length}</span></div><span>Newest first</span></div>
            <div class="writing-posts-grid">
              {writingPosts.map((post) => <ArticleCard post={post} />)}
            </div>
            </div>
          </section>
        ) : null}

        <CTASection />
      </main>
      <Footer />
    </div>
</SiteLayout>
