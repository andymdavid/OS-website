---
import SiteLayout from '../layouts/SiteLayout.astro';
import NavigationDraft from '@/components/astro/Navigation.astro';
import Hero from '../components/astro/Hero.astro';
import FunnelHomeDuplicate from '@/components/astro/Funnel.astro';
import HomeDuplicateGridSection from '@/components/astro/UseCases.astro';
import HomeDuplicateCanvasSection from '@/components/astro/OperatingMap.astro';
import HomeDuplicateComparison from '@/components/astro/Comparison.astro';
import FAQHomeDuplicate from '@/components/astro/FAQ.astro';
import CTAHomeDuplicate from '@/components/astro/CTA.astro';
import HomeDuplicateExitNewsletter from '@/components/astro/ExitNewsletter.astro';
import FooterHomeDuplicate from '@/components/astro/FooterHomeDuplicate.astro';
import { organizationSchema, websiteSchema } from '../lib/structured-data';
---
<SiteLayout title="Other Stuff | AI agents and automation for SMEs | Perth & Australia" description="We set up AI agents inside your business and automate the repetitive work. From $5k a month, cancel anytime. Perth and across Australia." path="/" schema={[
  { ...organizationSchema, description: 'AI automation partner in Perth, Western Australia setting up agents and automating repetitive work for Australian SMEs.' },
  websiteSchema,
]}>
  <div class="os-theme os-draft os-home-duplicate">
    <NavigationDraft />
    <main>
      <Hero />
      <!-- critical-css:main:start -->
      <FunnelHomeDuplicate />
      <HomeDuplicateGridSection />
      <HomeDuplicateCanvasSection />
      <HomeDuplicateComparison />
      <FAQHomeDuplicate />
      <CTAHomeDuplicate heading="What’s eating your team’s week?" intro="Book a free 45-minute call with Pete and Andy. We’ll look at how work moves through your business and tell you what we’d automate first and what it would cost." />
      <!-- critical-css:main:end -->
    </main>
    <!-- critical-css:footer:start -->
    <HomeDuplicateExitNewsletter />
    <FooterHomeDuplicate />
    <!-- critical-css:footer:end -->
  </div>
</SiteLayout>

<style is:global>
  /* Reserve offscreen section space without laying out its contents on load.
     Auto remembers the real height once rendered; unsupported browsers render normally. */
  @supports (content-visibility: auto) {
    .os-home-duplicate .funnel-section-home-duplicate { content-visibility: auto; contain-intrinsic-block-size: auto 950px; }
    .os-home-duplicate .home-comparison-section { content-visibility: auto; contain-intrinsic-block-size: auto 995px; }
    .os-home-duplicate .faq-section-home { content-visibility: auto; contain-intrinsic-block-size: auto 835px; }
    .os-home-duplicate .cta-section-home { content-visibility: auto; contain-intrinsic-block-size: auto 381px; }
    .os-home-duplicate .footer-home-duplicate { content-visibility: auto; contain-intrinsic-block-size: auto 630px; }
    @media (min-width: 769px) and (max-width: 1199px) {
      .os-home-duplicate .funnel-section-home-duplicate { contain-intrinsic-block-size: auto 1887px; }
      .os-home-duplicate .home-comparison-section { contain-intrinsic-block-size: auto 975px; }
      .os-home-duplicate .faq-section-home { contain-intrinsic-block-size: auto 815px; }
      .os-home-duplicate .cta-section-home { contain-intrinsic-block-size: auto 360px; }
      .os-home-duplicate .footer-home-duplicate { contain-intrinsic-block-size: auto 945px; }
    }
    @media (max-width: 768px) {
      .os-home-duplicate .funnel-section-home-duplicate { contain-intrinsic-block-size: auto 2150px; }
      .os-home-duplicate .home-comparison-section { contain-intrinsic-block-size: auto 950px; }
      .os-home-duplicate .faq-section-home { contain-intrinsic-block-size: auto 740px; }
      .os-home-duplicate .cta-section-home { contain-intrinsic-block-size: auto 350px; }
      .os-home-duplicate .footer-home-duplicate { contain-intrinsic-block-size: auto 1185px; }
    }
  }
</style>
