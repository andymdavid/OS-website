---
import SiteLayout from '@/layouts/SiteLayout.astro';
import NavigationDraft from '@/components/astro/Navigation.astro';
import { HeroHomeDuplicate } from '@/components/HeroHomeDuplicate';
import HomeDuplicateGridSection from '@/components/astro/UseCases.astro';
import FunnelHomeDuplicate from '@/components/astro/Funnel.astro';
import { ProcessTimeline } from '@/components/ProcessTimeline';
import { ExamplesSection } from '@/components/ExamplesSection';
import InfrastructureSection from '@/components/astro/InfrastructureSection.astro';
import FAQHomeDuplicate from '@/components/astro/FAQ.astro';
import { GoodStuffHomeDuplicate } from '@/components/GoodStuffHomeDuplicate';
import CTAHomeDuplicate from "@/components/astro/CTA.astro";
import FooterHomeDuplicate from '@/components/astro/FooterHomeDuplicate.astro';
import { organizationSchema, websiteSchema } from '../lib/structured-data';


---
<SiteLayout title="Home (Archived)"
        description="Custom AI systems for SMEs in Perth and across Australia, built around the workflows that improve margins, free up capital, and reduce operational risk."
        path="/home-duplicate"
        noindex
        schema={[
          {
            ...organizationSchema,
            description:
              'AI-first product studio in Perth, Western Australia building custom AI systems for SMEs around real operational workflows.',
          },
          websiteSchema,
        ]}>
<div class="os-theme os-draft">
      
      <NavigationDraft />
      <main>
        <HeroHomeDuplicate client:visible />
        <HomeDuplicateGridSection />
        <FunnelHomeDuplicate />
        <ProcessTimeline client:visible />
        <ExamplesSection client:visible />
        <InfrastructureSection />
        <FAQHomeDuplicate />
        <GoodStuffHomeDuplicate client:visible />
        <CTAHomeDuplicate />
      </main>
      <FooterHomeDuplicate />
    </div>
</SiteLayout>
