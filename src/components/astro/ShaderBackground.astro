<os-shader><canvas class="hero-shader-canvas" aria-hidden="true"></canvas></os-shader>
<script>
  import { initializeShader } from '../../lib/hero-shader';
  class ShaderBackground extends HTMLElement {
    private observer?: IntersectionObserver;
    private cleanup?: () => void;
    connectedCallback() {
      const canvas = this.querySelector('canvas');
      if (!canvas) return;
      this.observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        this.observer?.disconnect();
        this.cleanup = initializeShader(canvas);
      }, { rootMargin: '100px' });
      this.observer.observe(canvas);
    }
    disconnectedCallback() { this.observer?.disconnect(); this.cleanup?.(); }
  }
  if (!customElements.get('os-shader')) customElements.define('os-shader', ShaderBackground);
</script>
<style>os-shader { display: contents; }</style>
