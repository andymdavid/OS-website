---
import '../ArticleShare.css';
interface Props {title: string; url: string;}
const {title, url} = Astro.props;
---
<article-share class="article-share" data-url={url} data-title={title}>
  <span class="article-share-label">Share</span>
  <div class="article-share-controls" role="group" aria-label="Share this article">
    <a class="article-share-icon" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="Share on LinkedIn"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M5.1 7.5a2.1 2.1 0 1 0 0-4.2 2.1 2.1 0 0 0 0 4.2ZM3.4 9h3.4v11.5H3.4V9Zm5.6 0h3.3v1.6c.5-.9 1.6-1.9 3.5-1.9 3.7 0 4.3 2.3 4.3 5.3v6.5h-3.4v-5.8c0-1.4 0-3.2-1.9-3.2-2 0-2.3 1.5-2.3 3.1v5.9H9V9Z"/></svg></a>
    <a class="article-share-icon" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.5 5.4 22H2.2l8.3-9.5L2.8 2h6.5l4.4 6.7L18.9 2Zm-1.1 18h1.8L8.3 3.9H6.4L17.8 20Z"/></svg></a>
    <a class="article-share-icon" href="https://primal.net/home" target="_blank" rel="noopener noreferrer" data-primal-share aria-label="Open Primal" title="Open Primal and paste a copied article link"><img src="/primal-logo-white.svg" width="20" height="20" alt="" /></a>
    <a class="article-share-icon" href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`} aria-label="Share by email" title="Share by email"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a>
    <button class="article-share-icon" type="button" data-copy-share hidden aria-label="Copy article link" title="Copy article link"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m10 13 4-4m-6 6-1 1a4.2 4.2 0 0 1-6-6l4-4a4.2 4.2 0 0 1 6 0m2 2 1-1a4.2 4.2 0 0 1 6 6l-4 4a4.2 4.2 0 0 1-6 0" transform="translate(1 2)"/></svg></button>
    <button class="article-share-icon" type="button" data-native-share hidden aria-label="More sharing options" title="More sharing options"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3m-4 4 4-4 4 4M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg></button>
  </div>
  <p class="article-share-status" role="status" aria-live="polite" data-share-status></p>
  <div class="article-share-fallback" data-share-fallback hidden><label>Article link<input readonly value={url} aria-label="Article link to copy" /></label></div>
  <noscript><p class="article-share-note">To share on Primal, copy this page’s address and paste it into a new post.</p></noscript>
</article-share>
<script>import '../../client/article-share';</script>
