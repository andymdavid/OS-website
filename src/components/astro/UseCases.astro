---
import { AIChatDemo } from '../AIChatDemo';
import { FormProcessingDemo } from '../FormProcessingDemo';
import { DataAnalysisDemo } from '../DataAnalysisDemo';
import { WingmanDemo } from '../WingmanDemo';
import { CAL_DISCOVERY_URL } from '../../lib/links';
import BookCallContent from './BookCallContent.astro';
import '../HomeDuplicateGridSection.css';

const cards = [
  {
    title: 'Marketing',
    description:
      'Keep your marketing running consistently, even when the team is flat out on client work.',
    tags: ['Lead capture', 'Outreach', 'Campaign reporting'],
    demo: 'FormProcessingDemo',
    image: '/examples-inventory-landscape.webp',
  },
  {
    title: 'Sales',
    description:
      'Handle the prep, paperwork and follow-up around every deal, so your people spend their time with clients.',
    tags: ['Prospect research', 'Proposals and quotes', 'Follow-up'],
    demo: 'AIChatDemo',
    image: '/examples-proposals-landscape.webp',
  },
  {
    title: 'Operations',
    description:
      "Take care of the updates, handoffs and chasing that keep jobs moving, so it doesn't all depend on a few key people.",
    tags: ['Client onboarding', 'Project updates', 'Handovers'],
    demo: 'WingmanDemo',
    image: '/examples-briefings-landscape.webp',
  },
  {
    title: 'Finance',
    description:
      "Keep billing, collections and reporting up to date, so you see cash and margin while there's still time to act.",
    tags: ['Invoicing', 'Margin reviews', 'Month-end reporting'],
    demo: 'DataAnalysisDemo',
    image: '/examples-reporting-landscape.webp',
  },
];
---
<section class="section home-duplicate-grid-section">
      <div class="section-container-wide">
        <div class="home-duplicate-grid-intro">
          <div class="home-duplicate-grid-heading">
            <div class="intro-pill fade-in">USE CASES</div>
            <h2 class="section-heading fade-in fade-in-stagger-1">
              AI that works across your business.
            </h2>
          </div>

          <div class="home-duplicate-grid-intro-copy">
            <p class="home-duplicate-grid-subpara fade-in fade-in-stagger-2">
              Every part of a business has work that eats time and slows things down. These are some
              of the areas where our clients feel it most.
            </p>

            <a
              class="home-duplicate-grid-cta book-call-button fade-in fade-in-stagger-3"
              href={CAL_DISCOVERY_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <BookCallContent />
            </a>
          </div>
        </div>

        <div class="home-duplicate-grid">
          {cards.map((card) => (
            <article  class="home-duplicate-grid-card">
              <div class="home-duplicate-grid-copy">
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <div class="home-duplicate-grid-tags" aria-label={`${card.title} examples`}>
                  {card.tags.map((tag) => <span >{tag}</span>)}
                </div>
              </div>
              <div class="home-duplicate-grid-visual">
                <img class="home-grid-background"
                  src={card.image.replace('/examples-', '/optimized/example-').replace('-landscape.webp', '-800.webp')}
                  srcset={[480, 800].map(width => `${card.image.replace('/examples-', '/optimized/example-').replace('-landscape.webp', `-${width}.webp`)} ${width}w`).join(', ')}
                  sizes="(max-width: 767px) calc(100vw - 48px), 45vw"
                  width="800" height="450" alt="" loading="lazy" decoding="async" />
                <div class="home-grid-demo">{card.demo === 'FormProcessingDemo' && <FormProcessingDemo client:visible />}{card.demo === 'AIChatDemo' && <AIChatDemo client:visible />}{card.demo === 'WingmanDemo' && <WingmanDemo client:visible />}{card.demo === 'DataAnalysisDemo' && <DataAnalysisDemo client:visible />}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
