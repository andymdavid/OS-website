---
import { InventoryDemo } from '../InventoryDemo';
import { ProposalBuilderDemo } from '../ProposalBuilderDemo';
import { PreMeetingBriefingsDemo } from '../PreMeetingBriefingsDemo';
import { ProjectStatusReportsDemo } from '../ProjectStatusReportsDemo';
import '../HomeDuplicateGridSection.css';
import '../MGGridSection.css';
const cards = [
  {
    tag: 'FINANCE & INVENTORY',
    title: 'Inventory Intelligence',
    description:
      'Stock levels and sales are tracked continuously, so slow movers and low stock are flagged early. Reorders are based on actual demand, not a spreadsheet. Less cash on shelves, fewer stockouts.',
    demo: 'InventoryDemo',
    summary: 'Slow-moving stock and low inventory are flagged. Reorder quantities follow actual sales.',
    image: '/examples-inventory-landscape.webp',
  },
  {
    tag: 'SALES & QUOTING',
    title: 'Proposal Builder',
    description:
      'When a new opportunity comes in, past work, pricing and case studies are pulled into a structured draft. Your team shapes and sends it instead of starting from scratch. Nothing useful gets forgotten.',
    demo: 'ProposalBuilderDemo',
    summary: 'Past work, case studies and pricing are assembled into a draft proposal ready for review.',
    image: '/examples-proposals-landscape.webp',
  },
  {
    tag: 'CLIENT SERVICE',
    title: 'Pre-Meeting Briefings',
    description:
      'Before each client meeting, recent conversations, open issues and new flags are pulled into one brief. Your team arrives prepared without digging through emails. Clients notice when you remember everything.',
    demo: 'PreMeetingBriefingsDemo',
    summary: 'Recent emails, CRM notes and open actions become a briefing with talking points and next steps.',
    image: '/examples-briefings-landscape.webp',
  },
  {
    tag: 'REPORTING',
    title: 'Project Status Reports',
    description:
      'Project status, progress and issues are pulled from your project data into a report ready to send. Your team reviews it instead of compiling it. Every update reflects where things stand today.',
    demo: 'ProjectStatusReportsDemo',
    summary: 'Delivery progress, budget and risks become a current project report ready for your team to send.',
    image: '/examples-reporting-landscape.webp',
  },
];

---
<section id="what-we-build" class="section home-duplicate-grid-section">
      <div class="section-container-wide">
        <div class="home-duplicate-grid-intro">
          <div class="intro-pill fade-in">EXAMPLES OF WHAT WE AUTOMATE</div>
          <h2 class="section-heading fade-in fade-in-stagger-1">
            Automation built around the processes costing your team the most time and money.
          </h2>
          <p class="home-duplicate-grid-subpara fade-in fade-in-stagger-2">
            Each month, we start with the work where automation will make the clearest commercial difference. Examples include:
          </p>
        </div>

        <div class="home-duplicate-grid">
          {cards.map((card) => (
            <article class="home-duplicate-grid-card">
              <div class="home-duplicate-grid-copy">
                <span class="mg-grid-tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>
              <div
                class="home-duplicate-grid-visual"
                style={`--card-bg: url('${card.image}')`}
              >
                <div class="automation-demo-live">
                  {card.demo === 'InventoryDemo' && <InventoryDemo client:visible />}
                  {card.demo === 'ProposalBuilderDemo' && <ProposalBuilderDemo client:visible />}
                  {card.demo === 'PreMeetingBriefingsDemo' && <PreMeetingBriefingsDemo client:visible />}
                  {card.demo === 'ProjectStatusReportsDemo' && <ProjectStatusReportsDemo client:visible />}
                </div>
                <noscript><div class="automation-demo-fallback"><strong>{card.title}</strong><p>{card.summary}</p></div></noscript>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>


<noscript><style>.automation-demo-live { display: none; }</style></noscript>
