---
import {canonicalPath} from '@/lib/structured-data';
import '../ArticleCard.css';
interface Props {
  post: {slug: string; title: string; description: string; date: string; displayDate: string; readTime: string};
  heading?: 'h2' | 'h3';
}
const {post, heading = 'h2'} = Astro.props;
const Heading = heading;
---
<article class="article-card">
  <a class="article-card-link" href={canonicalPath(`/writing/${post.slug}`)}>
    <div class="article-card-meta"><time datetime={post.date}>{post.displayDate}</time><span aria-hidden="true">·</span><span>{post.readTime}</span></div>
    <Heading class="article-card-title">{post.title}</Heading>
    <p class="article-card-description">{post.description}</p>
    <span class="article-card-action">Read article <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  </a>
</article>
