---
import {canonicalPath} from '@/lib/structured-data';
import '../ArticleCard.css';
interface Props {
  post: {slug: string; title: string; description: string; cardSummary?: string; date: string; displayDate: string; readTime: string};
  heading?: 'h2' | 'h3';
}
const {post, heading = 'h2'} = Astro.props;
const Heading = heading;
const cardDate = new Intl.DateTimeFormat('en-AU', {day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'}).format(new Date(`${post.date}T00:00:00Z`));
---
<article class="article-card">
  <a class="article-card-link" href={canonicalPath(`/writing/${post.slug}`)}>
    <div class="article-card-heading">
      <Heading class="article-card-title">{post.title}</Heading>
      <svg class="article-card-arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <p class="article-card-description">{post.cardSummary || post.description}</p>
    <div class="article-card-meta"><time datetime={post.date}>{cardDate}</time><span aria-hidden="true">·</span><span>{post.readTime}</span></div>
  </a>
</article>
