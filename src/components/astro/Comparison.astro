---
import '../HomeDuplicateComparison.css';
import { CAL_DISCOVERY_URL } from '../../lib/links';
import BookCallContent from './BookCallContent.astro';
type FitValue = 'yes' | 'partial' | 'no';

interface ComparisonRow {
  label: string;
  note?: string;
  values: [FitValue, FitValue, FitValue, FitValue];
}

const columns = ['SaaS', 'Agency', 'Full-time Hire', 'Other Stuff'];

const rows: ComparisonRow[] = [
  {
    label: 'Working in weeks, not months',
    values: ['partial', 'no', 'no', 'yes'],
  },
  {
    label: 'Month to month, cancel anytime',
    values: ['yes', 'no', 'no', 'yes'],
  },
  {
    label: 'Built around how you work',
    values: ['no', 'yes', 'yes', 'yes'],
  },
  {
    label: 'AI agents doing real work',
    values: ['no', 'partial', 'partial', 'yes'],
  },
  {
    label: 'Knows your business',
    values: ['no', 'partial', 'partial', 'yes'],
  },
  {
    label: 'A person signs off before anything goes out',
    values: ['partial', 'partial', 'partial', 'yes'],
  },
  {
    label: 'Your team trained to run it',
    values: ['no', 'partial', 'no', 'yes'],
  },
  {
    label: 'Custom software when you need it',
    values: ['no', 'yes', 'partial', 'yes'],
  },
  {
    label: 'Open source, no lock-in',
    values: ['no', 'partial', 'partial', 'yes'],
  },
];

const valueLabels: Record<FitValue, string> = {
  yes: 'Included',
  partial: 'Depends or costs extra',
  no: 'Usually no',
};

const valueSymbols: Record<FitValue, string> = {
  yes: '✓',
  partial: '◐',
  no: '–',
};
---
<section class="section home-comparison-section">
      <div class="section-container-wide">
        <div class="home-comparison-intro">
          <div class="home-comparison-heading">
            <div class="intro-pill fade-in">WHY THIS MODEL</div>
            <h2 class="section-heading fade-in fade-in-stagger-1">
              A better way to bring AI
              <br />
              into your business.
            </h2>
          </div>

          <div class="home-comparison-intro-copy">
            <p class="home-comparison-copy fade-in fade-in-stagger-2">
              Software subscriptions don&apos;t know your business. Agencies want a big project before
              you see anything work. A new hire is expensive and slow to get up to speed. We start
              small and show you results in the first month.
            </p>
            <a
              class="home-comparison-cta book-call-button fade-in fade-in-stagger-3"
              href={CAL_DISCOVERY_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <BookCallContent />
            </a>
          </div>
        </div>

        <div class="home-comparison-table-shell fade-in fade-in-stagger-3">
          <div class="home-comparison-scroll-cue" aria-hidden="true">
            <span>Swipe to compare</span>
            <svg viewBox="0 0 24 24">
              <path d="M5 12h14M14 7l5 5-5 5" />
            </svg>
          </div>
          <div class="home-comparison-table-wrap">
            <table class="home-comparison-table">
            <colgroup>
              <col class="comparison-criteria-col" />
              <col class="comparison-standard-col" />
              <col class="comparison-standard-col" />
              <col class="comparison-standard-col" />
              <col class="comparison-other-col" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col" aria-label="Comparison criteria"></th>
                {columns.map((column) => (
                  <th scope="col" >
                    {column}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr
                >
                  <th scope="row">
                    <span class="comparison-row-label">{row.label}</span>
                  </th>
                  {row.values.map((value, index) => (
                    <td
                      
                      class={`comparison-value comparison-value-${value}`}
                    >
                      <span aria-label={`${columns[index]}: ${valueLabels[value]}`}>
                        {valueSymbols[value]}
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
            </table>
          </div>
        </div>
        <div class="home-comparison-legend" aria-label="Comparison legend">
          <span><b class="comparison-value-yes">✓</b> Included</span>
          <span><b class="comparison-value-partial">◐</b> Depends or costs extra</span>
          <span><b class="comparison-value-no">–</b> Usually no</span>
        </div>
      </div>
    </section>
