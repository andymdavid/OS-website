---
import { deliveryStatic } from '../../lib/delivery-assets';
import '../HomeDuplicateLogoCarousel.css';
const logos = [
  {src:deliveryStatic('/optimized/client-adapt-200.webp'),alt:'Adapt'},
  {src:deliveryStatic('/optimized/client-stakwork-200.webp'),alt:'Stakwork'},
  {src:deliveryStatic('/optimized/client-rocky-bay-200.webp'),alt:'Rocky Bay'},
  {src:deliveryStatic('/logos/home-duplicate/plantrite.svg'),alt:'Plantrite'},
];
const logoSet=[...logos,...logos,...logos];
---
<section class="home-duplicate-client-bar" aria-label="Selected client logos">
  <div class="home-duplicate-client-bar__inner"><div class="home-duplicate-client-bar__track"><div class="home-duplicate-client-bar__logos">
    {[false,true].map(hidden=>(<div class="home-duplicate-client-bar__logo-set" aria-hidden={hidden || undefined}>
      {logoSet.map((logo,index)=>(<img src={logo.src} width="200" height="100" alt={hidden || index>=logos.length ? '' : logo.alt} class="home-duplicate-client-bar__logo" loading="eager" decoding="async" />))}
    </div>))}
  </div></div></div>
</section>
