---
import '../IntroSection.css';
import '../CTASection.css';
import { BookCallContent } from '../BookCallContent';
import { CAL_DISCOVERY_URL } from '../../lib/links';
const { pillLabel = 'Get Started', heading = "Let's talk about what's slowing your business down.", intro = "Book a free intro call. We'll look at where time is going and whether a custom AI system makes sense for your business.", buttonLabel = 'Book a Call', className = '' } = Astro.props;
---
<section class={`section cta-section cta-section-home ${className}`.trim()}>
  <div class="cta-card">
    <div class="intro-pill">{pillLabel}</div>
    <h2 class="section-heading cta-heading">{heading.split('\n').map((line: string, index: number) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</h2>
    <p class="cta-intro">{intro}</p>
    <a href={CAL_DISCOVERY_URL} target="_blank" rel="noopener noreferrer" class={`btn-primary cta-button cta-button-orange ${buttonLabel === 'Book a Call' ? 'book-call-button' : ''}`}>
      {buttonLabel === 'Book a Call' ? <BookCallContent /> : buttonLabel}
    </a>
  </div>
</section>
